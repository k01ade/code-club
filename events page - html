<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Beths Code Club | Events</title>

    <link rel="stylesheet" href="css/events.css">
</head>

<body>

    <!-- HEADER -->

    <header class="header">

        <div class="logo">
            <span class="logo-symbol">{ }</span>
            <span>Beths Code Club</span>
        </div>

        <nav>
            <a href="index.html">Join Here</a>
            <a href="mission.html">Our Mission</a>
            <a href="events.html">Events</a>
            <a href="contact.html">Contact</a>
        </nav>

    </header>


    <!-- MAIN CONTENT -->

    <main>

        <!-- INTRODUCTION -->

        <section class="intro">

            <h1>OUR EVENTS</h1>

            <p class="tagline">
                Learn, Code, Network
            </p>

            <p>
                Our events give students the opportunity to develop
                their programming skills, solve problems and connect
                with other students who share an interest in computer
                science.
            </p>

        </section>


        <!-- UPCOMING EVENTS -->

        <section class="upcoming">

            <h2>UPCOMING EVENTS</h2>

            <div class="event-list">


                <!-- EVENT 1 -->

                <article class="event-card">

                    <div class="event-image">
                        <img src="images/event1.jpg"
                             alt="Students working on computers">
                    </div>

                    <div class="event-content">

                        <h3>WEB DEVELOPMENT WORKSHOP</h3>

                        <p>
                            Learn the fundamentals of HTML and CSS
                            while building your own webpage.
                        </p>

                        <div class="event-details">

                            <p>
                                <strong>Date:</strong>
                                12 September 2026
                            </p>

                            <p>
                                <strong>Time:</strong>
                                4:00 PM – 5:30 PM
                            </p>

                            <p>
                                <strong>Location:</strong>
                                Computer Science Room
                            </p>

                        </div>

                        <a href="#" class="event-button">
                            JOIN EVENT
                        </a>

                    </div>

                </article>


                <!-- EVENT 2 -->

                <article class="event-card">

                    <div class="event-image">
                        <img src="images/event2.jpg"
                             alt="Student programming">
                    </div>

                    <div class="event-content">

                        <h3>PYTHON CODING CHALLENGE</h3>

                        <p>
                            Test your programming and problem-solving
                            skills through a series of Python challenges.
                        </p>

                        <div class="event-details">

                            <p>
                                <strong>Date:</strong>
                                19 September 2026
                            </p>

                            <p>
                                <strong>Time:</strong>
                                4:00 PM – 6:00 PM
                            </p>

                            <p>
                                <strong>Location:</strong>
                                Computer Science Room
                            </p>

                        </div>

                        <a href="#" class="event-button">
                            JOIN EVENT
                        </a>

                    </div>

                </article>


                <!-- EVENT 3 -->

                <article class="event-card">

                    <div class="event-content">

                        <h3>COMPUTER SCIENCE PROJECT HELP</h3>

                        <p>
                            Bring your programming questions and get
                            guidance from other students and club members.
                        </p>

                        <div class="event-details">

                            <p>
                                <strong>Date:</strong>
                                26 September 2026
                            </p>

                            <p>
                                <strong>Time:</strong>
                                4:00 PM – 5:30 PM
                            </p>

                            <p>
                                <strong>Location:</strong>
                                Computer Science Room
                            </p>

                        </div>

                        <a href="#" class="event-button">
                            JOIN EVENT
                        </a>

                    </div>

                </article>

            </div>

        </section>


        <!-- PAST EVENTS -->

        <section class="past-events">

            <h2>PAST EVENTS</h2>

            <p>
                Take a look at some of the activities and events
                that Beths Code Club has previously hosted.
            </p>

            <div class="past-event-grid">

                <div class="past-event">
                    <h3>CODING COMPETITION</h3>
                    <p>
                        Students competed against each other
                        to solve programming challenges.
                    </p>
                </div>

                <div class="past-event">
                    <h3>WEB DEVELOPMENT</h3>
                    <p>
                        Students learnt the foundations of
                        building websites using HTML and CSS.
                    </p>
                </div>

            </div>

        </section>


        <!-- JOIN SECTION -->

        <section class="join-section">

            <h2>JOIN US HERE</h2>

            <p>
                Want to learn more about Beths Code Club?
                Come along to one of our events and start coding.
            </p>

            <a href="#" class="join-button">
                JOIN THE CLUB
            </a>

        </section>

    </main>


    <!-- FOOTER -->

    <footer>

        <p>
            Beths Code Club
        </p>

        <p>
            Learn. Code. Network.
        </p>

    </footer>

</body>

</html>
